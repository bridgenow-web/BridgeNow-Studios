# ──────────────────── Razorpay (UPI Autopay) ───────────
RAZORPAY_KEY_ID="rzp_live_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"
# Plan IDs created once in the Razorpay dashboard / API
# Creator Basic is LIFETIME — a one-off payment, so it needs no Razorpay
# plan. Leave it unset; checkout never creates a mandate for it.
RAZORPAY_PLAN_CREATOR_PLUS="plan_xxx"
RAZORPAY_PLAN_CREATOR_GROWTH_PRO="plan_xxx"
RAZORPAY_PLAN_CREATOR_ELITE="plan_xxx"
RAZORPAY_PLAN_CREATOR_PREMIUM="plan_xxx"
RAZORPAY_PLAN_BRAND_STARTER="plan_xxx"
RAZORPAY_PLAN_BRAND_GROWTH_PLUS="plan_xxx"
RAZORPAY_PLAN_BRAND_PREMIUM="plan_xxx"
# brand_custom is quoted, not a gateway plan — invoiced manually
RAZORPAY_PLAN_BRAND_CUSTOM="plan_xxx"

# ─────────────────── Static UPI (QR fallback) ──────────
NEXT_PUBLIC_UPI_VPA="rajkumarbhol29@oksbi"
